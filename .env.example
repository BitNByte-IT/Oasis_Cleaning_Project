# ============================================
# Site
# ============================================
NEXT_PUBLIC_SITE_URL=https://oasiscleaningofaustin.com

# ============================================
# Google Places API - for fetching live reviews
# Create a project at https://console.cloud.google.com/
# Enable "Places API (New)" and create an API key
# Find your business Place ID at: https://developers.google.com/maps/documentation/places/web-service/place-id
# ============================================
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_business_place_id_here

# ============================================
# Email Sending - for "Get a Free Quote" form
# Using Gmail SMTP (you can swap to SendGrid/Resend/etc.)
# For Gmail: enable 2-step verification then create an "App Password"
# https://myaccount.google.com/apppasswords
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Where the quote-request emails are delivered
QUOTE_RECIPIENT_EMAIL=your_recipient_email@example.com

# ============================================
# Newsletter - Google Sheets storage
# 1. Google Cloud Console → create project → enable "Google Sheets API"
# 2. IAM & Admin → Service Accounts → create account → create JSON key
# 3. Create a Google Sheet, share it with the service account email (Editor)
# 4. Spreadsheet ID is in the URL: /spreadsheets/d/<ID>/edit
# 5. Paste the private_key value from the JSON key (keep literal \n characters)
# ============================================
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# ============================================
# Optional: Revalidation secret (used by cron / webhook to refresh reviews cache)
# Generate a strong random string, e.g: openssl rand -hex 32
# ============================================
REVALIDATE_SECRET=your_long_random_secret_here
